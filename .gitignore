# ============================================
# 通用忽略规则
# ============================================

# 操作系统生成的文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 运行时数据
pids
*.pid
*.seed
*.pid.lock

# 覆盖率目录
coverage/
*.lcov

# 依赖目录
node_modules/
jspm_packages/

# 可选npm缓存目录
.npm

# ============================================
# 后端 (Spring Boot) 特定忽略规则
# ============================================

# Maven构建输出
target/
!**/src/main/**/target/
!**/src/test/**/target/

# Maven包装器
.mvn/wrapper/maven-wrapper.jar

# IDE文件
.idea/
*.iws
*.iml
*.ipr

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ============================================
# 前端 (Vue.js) 特定忽略规则
# ============================================

# 构建输出
/dist

# 本地环境文件
.env.local
.env.*.local

# 编辑器目录和文件
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ============================================
# 项目特定忽略规则
# ============================================

# 包管理器锁文件（根据项目需要选择是否忽略）
# package-lock.json
# yarn.lock

# 本地配置文件（包含敏感信息）
backend/src/main/resources/application-local.properties

# 临时文件
*.tmp
*.temp

# 压缩文件
*.zip
*.tar.gz
*.rar

# 备份文件
*.bak
*.backup

# 系统文件
~$*

# ============================================
# 开发工具特定忽略规则
# ============================================

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Windows
Desktop.ini

# MacOS
__MACOSX/

# ============================================
# 数据库相关
# ============================================

# 本地数据库文件
*.db
*.sqlite
*.mdf
*.ldf

# 数据库迁移临时文件
*.sql~

# ============================================
# 测试相关
# ============================================

# 测试覆盖率报告
coverage/
.nyc_output/

# 测试结果
test-results/
*.trx

# ============================================
# 包管理器缓存
# ============================================

# npm缓存
.npm

# Yarn缓存
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ============================================
# 其他
# ============================================

# 大型媒体文件（如果项目需要可以移除）
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.mkv

# 文档备份
*.docx~
*.pdf~
*.xlsx~